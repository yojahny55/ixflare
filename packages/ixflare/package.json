{
  "name": "ixflare",
  "version": "0.0.1",
  "description": "Edge-native fullstack framework for Cloudflare Workers",
  "keywords": [
    "cloudflare",
    "workers",
    "edge",
    "fullstack",
    "framework",
    "ssr",
    "react",
    "orm"
  ],
  "license": "MIT",
  "author": "Ixflare Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./orm": {
      "import": {
        "types": "./dist/orm.d.ts",
        "default": "./dist/orm.mjs"
      },
      "require": {
        "types": "./dist/orm.d.cts",
        "default": "./dist/orm.cjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./dist/ssr.d.ts",
        "default": "./dist/ssr.mjs"
      },
      "require": {
        "types": "./dist/ssr.d.cts",
        "default": "./dist/ssr.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "urlpattern-polyfill": "^10.1.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "sideEffects": false
}
