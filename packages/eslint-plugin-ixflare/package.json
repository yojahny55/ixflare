{
  "name": "eslint-plugin-ixflare",
  "version": "0.1.0",
  "description": "ESLint plugin for Ixflare environment boundary enforcement",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "ixflare",
    "cloudflare",
    "workers"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/eslint": "^8.0.0",
    "@types/estree": "^1.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  }
}
