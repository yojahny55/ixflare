{
  "name": "vite-plugin-ixflare",
  "version": "0.0.1",
  "description": "Vite plugin for Ixflare framework - file-based routing for Cloudflare Workers",
  "keywords": [
    "vite",
    "vite-plugin",
    "ixflare",
    "cloudflare",
    "workers",
    "file-based-routing"
  ],
  "license": "MIT",
  "author": "Ixflare Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "ixflare": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0",
    "@cloudflare/vite-plugin": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    }
  }
}
