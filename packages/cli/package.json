{
  "name": "@ixflare/cli",
  "version": "0.0.1",
  "description": "CLI commands for Ixflare framework",
  "keywords": [
    "cli",
    "ixflare",
    "cloudflare",
    "workers"
  ],
  "license": "MIT",
  "author": "Ixflare Team",
  "type": "module",
  "bin": {
    "ix": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ixflare": "workspace:*",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/prompts": "^2.4.9",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "0.31.8",
    "drizzle-orm": "^0.45.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
