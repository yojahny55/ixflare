# ====================
# Environment Variables
# ====================
# Copy this file to .env.local for local development
# NEVER commit .env.local or .dev.vars to version control

# -------------------
# Database
# -------------------
# D1 database connection (handled by Cloudflare bindings)
# DATABASE_URL=

# -------------------
# Authentication
# -------------------
# JWT signing secret (generate with: openssl rand -hex 32)
# JWT_SECRET=

# Session cookie secret
# SESSION_SECRET=

# -------------------
# External Services
# -------------------
# Third-party API keys
# API_KEY=

# -------------------
# Feature Flags
# -------------------
# DEBUG=false
# VERBOSE_LOGGING=false
